// Reportage Post — схема ядра (S1).
// Инварианты (CLAUDE.md): деньги — минорные единицы + валюта; время — UTC;
// телефоны — E.164; гео — дерево страна→регион→город; активность — события.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL — в prisma.config.ts (Prisma 7); рантайм — через adapter-pg в src/lib/db.ts
}

// ─── Пользователи и роли ────────────────────────────────────────────────────

enum UserRole {
  PHOTOGRAPHER
  CLIENT
  ADMIN
}

enum UserStatus {
  PENDING // зарегистрирован, портфолио на модерации
  ACTIVE
  BANNED
}

model User {
  id                   String     @id @default(cuid())
  role                 UserRole
  status               UserStatus @default(PENDING)
  // Настоящие имя и фамилия (правило площадки, как у MyWed)
  firstName            String
  lastName             String
  email                String?    @unique
  phone                String?    @unique // E.164: +79991234567
  phoneVerifiedAt      DateTime? @db.Timestamptz(3)
  emailVerifiedAt      DateTime? @db.Timestamptz(3) // подтверждение адреса по ссылке из письма
  passwordHash         String?
  passwordChangedAt    DateTime? @db.Timestamptz(3) // инвалидация старых JWT при смене пароля
  tokenVersion         Int        @default(0) // ручной отзыв всех сессий (бан/логаут-везде)
  tgUserId             String?    @unique // Telegram chat_id для уведомлений (S2)
  yandexId             String?    @unique // Яндекс OAuth: id аккаунта для входа/линковки
  tgLinkCode           String?    @unique // одноразовый код привязки (deep-link /start)
  locale               String     @default("ru")
  inviteCodeId         String? // закрытость до S4: кто пригласил
  // Настройки уведомлений (аудит 2026-07-31, P1): отключить письма и телеграм
  // было НЕЧЕМ — единственным выходом оставалось удалить аккаунт. Рассылка
  // заявок это не транзакционное письмо «по вашему действию», а регулярный
  // поток, и человек вправе его выключить, не теряя аккаунт.
  // Транзакционные письма (сброс пароля, подтверждение адреса) настройками НЕ
  // отключаются — без них теряется доступ.
  notifyInquiriesEmail Boolean    @default(true)
  notifyInquiriesTg    Boolean    @default(true)
  // Одноразовый ключ отписки для ссылки в письме (без входа в аккаунт)
  unsubToken           String?    @unique
  pdnConsentAt         DateTime? @db.Timestamptz(3) // согласие на обработку ПДн (152-ФЗ)
  pdnConsentVersion    String? // версия принятой политики
  totpSecret           String? // секрет TOTP (2FA); null — 2FA не настроена
  twoFactorEnabledAt   DateTime? @db.Timestamptz(3) // 2FA включена (подтверждена кодом)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  lastSeenAt           DateTime? @db.Timestamptz(3)

  profile            PhotographerProfile?
  inviteCode         InviteCode?            @relation(fields: [inviteCodeId], references: [id])
  issuedInvites      InviteCode[]           @relation("issuedInvites")
  subscription       Subscription?
  payments           Payment[]
  events             ActivityEvent[]        @relation("actor")
  likes              Like[]
  comments           Comment[]
  reviews            Review[]
  shootConfirmations ShootConfirmation[]
  follows            Follow[]               @relation("follower")
  followedBy         Follow[]               @relation("followee")
  inquiries          Inquiry[]
  favorites          FavoritePhotographer[]
  phoneVerifications PhoneVerification[]
  sentMessages       Message[]              @relation("sender")
  recvMessages       Message[]              @relation("recipient")
  notifications      Notification[]
  adminAudits        AdminAudit[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  recoveryCodes      RecoveryCode[]
  reportsMade        Report[]               @relation("reporter")
  reportsResolved    Report[]               @relation("reportResolver")
  blocksMade         UserBlock[]            @relation("blocker")
  blockedBy          UserBlock[]            @relation("blocked")

  // См. комментарий у PhotographerProfile: индексы поиска описаны в схеме,
  // чтобы migrate diff не пытался их снести.
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, name: "User_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, name: "User_lastName_trgm_idx")
}

// Верификация телефона по SMS-коду (E.164). Код хранится как argon2-хеш
// (не в открытом виде), с TTL и лимитом попыток.
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  phone     String // E.164
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Rate-limit счётчики (аудит P1 #3): фиксированное окно, ключ+начало окна.
model RateLimit {
  key         String
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Закрытость до публичного запуска (S4): регистрация только по инвайтам
model InviteCode {
  id             String    @id @default(cuid())
  code           String    @unique
  note           String? // кому выдан (амбассадор, ближний круг)
  maxUses        Int       @default(1)
  usedCount      Int       @default(0)
  expiresAt      DateTime? @db.Timestamptz(3)
  issuedByUserId String? // атрибуция: кто выдал (S3 персональные инвайты)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  users          User[]
  issuedBy       User?     @relation("issuedInvites", fields: [issuedByUserId], references: [id])
}

// ─── География: дерево страна → регион → город ─────────────────────────────

model Country {
  id      String   @id @default(cuid())
  code    String   @unique // ISO 3166-1 alpha-2: RU
  slug    String   @unique // russia — для URL
  nameKey String // i18n-ключ: geo.country.russia
  active  Boolean  @default(false) // включаем страны по мере экспансии
  regions Region[]
  cities  City[]
}

model Region {
  id        String  @id @default(cuid())
  countryId String
  slug      String
  nameKey   String
  country   Country @relation(fields: [countryId], references: [id])
  cities    City[]

  @@unique([countryId, slug])
}

model City {
  id        String  @id @default(cuid())
  countryId String
  regionId  String?
  slug      String // moscow — для URL /ru/russia/moscow-…
  nameKey   String
  active    Boolean @default(false) // посев: Мск+СПб; SEO-страницы — все города
  lat       Float?
  lon       Float?

  country     Country               @relation(fields: [countryId], references: [id])
  region      Region?               @relation(fields: [regionId], references: [id])
  profiles    PhotographerProfile[]
  inquiries   Inquiry[]
  travelPlans TravelPlan[]

  @@unique([countryId, slug])
  @@index([active])
}

// ─── Категории репортажной съёмки ───────────────────────────────────────────

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique // business-events, corporate, concerts, sports, private-events, press
  nameKey   String // i18n-ключ
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  profiles      ProfileCategory[]
  photos        Photo[]
  stories       Story[]
  inquiries     Inquiry[]
  profileScores ProfileCategoryScore[]
}

// Жанровый рейтинг (рейтинг v2, «ранжирование категория×город»): скор профиля
// ВНУТРИ жанра — engagement по лайкам фото ЭТОЙ категории (с тем же затуханием)
// + общая база (полнота+отзывы). Специалист жанра ранжируется в нём выше
// генералиста с равным глобальным ratingScore. Пересчёт — вместе с ratingScore
// (recomputeOne/recomputeRatings), строки категорий, покинувших профиль, удаляются.
model ProfileCategoryScore {
  profileId  String
  categoryId String
  scoreMilli Int      @default(0)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  profile  PhotographerProfile @relation(fields: [profileId], references: [id])
  category Category            @relation(fields: [categoryId], references: [id])

  @@id([profileId, categoryId])
  // Выдача категории: сортировка по скору внутри жанра
  @@index([categoryId, scoreMilli(sort: Desc)])
}

// ─── Профиль фотографа ──────────────────────────────────────────────────────

enum ModerationStatus {
  DRAFT // черновик (создан админом, не подан, не в каталоге)
  PENDING
  NEEDS_REVISION // возвращён фотографу на доработку с комментарием
  APPROVED
  REJECTED
}

model PhotographerProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  username         String            @unique // @slug профиля
  usernameHistory  UsernameHistory[] // прежние адреса → редирект
  inquiryHandlings InquiryHandling[] // отметки по входящим заявкам
  cityId           String
  bio              String?
  siteUrl          String?
  whatsapp         String? // E.164
  telegram         String? // @username
  languages        String[]          @default(["ru"]) // языки общения, ISO 639-1
  verified         Boolean           @default(false) // админ-верификация (trust-бейдж MyWed)
  avatarKey        String? // ключ аватара в хранилище (квадрат); нет — показываем инициалы
  coverPhotoId     String? // выбранная обложка каталога (иначе — лучший/первый кадр)
  experienceYears  Int? // стаж в годах (богатство анкеты, паритет MyWed)
  equipment        String? // legacy free-text; структурированные поля ниже (паритет MyWed + B2B-агрегация)
  cameras          String[]          @default([]) // камеры (структурировано для экспорта)
  // Нормализованные бренды камер — для фильтра каталога «Техника» (прототип v9).
  // Хранится отдельно от cameras: там свободный текст («Sony A7 IV»), по
  // которому нельзя ни отфильтровать по массиву, ни построить индекс. Здесь —
  // канонический список брендов, пересчитывается при сохранении анкеты.
  cameraBrands     String[]          @default([])
  lenses           String[]          @default([]) // оптика
  lighting         String[]          @default([]) // свет
  teamInfo         String? // соло / команда / ассистенты
  doesVideo        Boolean           @default(false) // снимает видео (роль «Фотограф · Видеограф»)
  // «Показать номер» (паритет MyWed): ЯВНЫЙ опт-ин — телефон собран для верификации,
  // без согласия на страницу не выводится. Раскрытие кликом через API + событие.
  showPhone        Boolean           @default(false)
  showreelUrls     String[]          @default([]) // шоурилы по ссылке (YouTube/Vimeo/RuTube/VK — whitelist-embed)
  faq              Json? // [{q,a}] частые вопросы (богатство анкеты, паритет MyWed)
  status           ModerationStatus  @default(PENDING)
  rejectReason     String?
  revisionNote     String? // комментарий «на доработку» (виден фотографу)
  // Денормализованный рейтинг для сортировки каталога (пересчёт фоном).
  // v1: полнота профиля + свежесть; v2 (S2): взвешенные лайки со сгоранием.
  ratingScore      Int               @default(0)
  // Денормализованный вес подписки в каталоге. Разворот 2026-07-25 (синергия, не
  // классовость): каталог ранжируется MERIT-первым (ratingScore), подписка — лишь
  // МЯГКИЙ tiebreaker в пределах равного рейтинга, НЕ pay-for-position. 0 = FREE;
  // PRIME_RANK = Prime; ELITE_RANK = Elite. Экспирация — реконсилятором.
  proRank          Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)

  user               User                   @relation(fields: [userId], references: [id])
  city               City                   @relation(fields: [cityId], references: [id])
  categories         ProfileCategory[]
  packages           PricePackage[]
  photos             Photo[]
  videos             ProfileVideo[]
  stories            Story[]
  busyDates          BusyDate[]
  travelPlans        TravelPlan[]
  favoritedBy        FavoritePhotographer[]
  reviews            Review[]
  shootConfirmations ShootConfirmation[]
  categoryScores     ProfileCategoryScore[]

  @@index([cityId, status, ratingScore(sort: Desc), proRank(sort: Desc)])
  // Индексы похожести для поиска (pg_trgm). Описаны здесь, а не только в
  // raw-миграции: иначе `migrate diff` их не видит и КАЖДЫЙ раз предлагает
  // удалить — рано или поздно это молча уехало бы в миграцию и поиск потерял
  // бы индексы, не сломавшись заметно (просто стал бы медленным).
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, name: "PhotographerProfile_username_trgm_idx")
}

model ProfileCategory {
  profileId  String
  categoryId String
  profile    PhotographerProfile @relation(fields: [profileId], references: [id])
  category   Category            @relation(fields: [categoryId], references: [id])

  @@id([profileId, categoryId])
  @@index([categoryId])
}

// Выездные графики (механика MyWed «фотограф едет в X»): фотограф из города A
// объявляет период работы в городе B — и показывается в каталоге B с пометкой.
model TravelPlan {
  id        String              @id @default(cuid())
  profileId String
  cityId    String // город назначения
  fromDate  DateTime            @db.Date
  toDate    DateTime            @db.Date
  profile   PhotographerProfile @relation(fields: [profileId], references: [id])
  city      City                @relation(fields: [cityId], references: [id])

  @@index([cityId, fromDate, toDate])
  @@index([profileId])
}

// Календарь занятости: фотограф отмечает занятые даты; каталог фильтрует
// «свободен на дату» (козырь против MyWed). Дата — UTC-полночь (@db.Date).
model BusyDate {
  id        String              @id @default(cuid())
  profileId String
  date      DateTime            @db.Date
  profile   PhotographerProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, date])
  @@index([date])
}

model PricePackage {
  id         String @id @default(cuid())
  profileId  String
  hours      Int // длительность пакета
  priceMinor Int // копейки/центы — НИКОГДА не float
  currency   String @default("RUB") // ISO 4217
  sortOrder  Int    @default(0)

  profile PhotographerProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

// ─── Контент: фото и серии ──────────────────────────────────────────────────

model Photo {
  id              String           @id @default(cuid())
  profileId       String
  categoryId      String
  storyId         String?
  storageKey      String           @unique // ключ в Object Storage; CDN-URL строится из него
  width           Int
  height          Int
  phash           String? // perceptual hash (dHash) для дедупа/анти-кражи портфолио
  blurhash        String? // плейсхолдер при загрузке
  sortOrder       Int              @default(0) // порядок в портфолио (перетаскивание в кабинете)
  status          ModerationStatus @default(PENDING)
  rejectReason    String?
  aiVerdict       Json? // вердикт AI-премодерации (подсказка модератору, НЕ решение)
  editorsChoiceAt DateTime? @db.Timestamptz(3) // красный флажок MyWed: ручная отметка редакции
  uploadedAt      DateTime         @default(now()) @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3)

  profile  PhotographerProfile @relation(fields: [profileId], references: [id])
  category Category            @relation(fields: [categoryId], references: [id])
  story    Story?              @relation(fields: [storyId], references: [id])
  likes    Like[]
  comments Comment[]

  @@index([profileId, status])
  // Топ-N свежих кадров профиля — самый частый доступ к фотографиям: карточка
  // каталога, страница города, лента, подборки. Без этого индекса сортировка
  // по дате шла в памяти поверх выборки по профилю.
  @@index([profileId, status, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([profileId, sortOrder])
  // Дискавери главной (categoryPreviews/editorsChoice сортируют по editorsChoiceAt) — аудит перф 2026-07-30
  @@index([status, editorsChoiceAt(sort: Desc), publishedAt(sort: Desc)])
  // Рекомендательная лента / превью жанров фильтруют по categoryId — аудит перф 2026-07-30
  @@index([categoryId, status])
  // Страница серии тянет фото по storyId — FK без индекса Postgres не создаёт (аудит P1)
  @@index([storyId])
  hasWebp     Boolean @default(false)

}

// Загруженное видео автора (шоурил/промо). Файл в Object Storage за абстракцией
// (storage.ts); раздача через /files с Range. Внешние ссылки — отдельно
// (PhotographerProfile.showreelUrls). Транскод не делаем: храним исходник,
// браузер играет mp4/webm нативно.
// Стадия обработки ролика. Отдельно от модерации: «файл ещё не готов к показу»
// и «редакция не одобрила» — разные состояния, и путать их нельзя (готовое, но
// неодобренное видео нельзя играть, а необработанное нечего и модерировать).
enum VideoProcessing {
  UPLOADED // исходник принят, ждёт воркер
  PROCESSING // ffmpeg в работе
  READY // варианты и постер лежат в хранилище
  FAILED // отбраковано probe-гардом или упало при транскоде
}

model ProfileVideo {
  id         String           @id @default(cuid())
  profileId  String
  storageKey String           @unique // videos/<uuid>/source.<ext> — ИСХОДНИК, наружу не отдаётся
  mimeType   String
  sizeBytes  Int
  title      String?
  posterKey  String? // кадр-обложка, генерится воркером
  sortOrder  Int              @default(0)
  status     ModerationStatus @default(PENDING) // роут ставит APPROVED сразу (автор уже прошёл модерацию профиля); поле — для будущего админ-тейкдауна по жалобе
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  // Пайплайн транскода: сырое видео не раздаём — вес и кодеки непредсказуемы,
  // а мобильный трафик заказчика оплачивает он, а не мы.
  processing     VideoProcessing @default(UPLOADED)
  hdKey          String? // 1080p, ~4 Мбит/с
  sdKey          String? // 720p, ~2.5 Мбит/с — по умолчанию на узких экранах
  durationSec    Int?
  width          Int?
  height         Int?
  codec          String?
  failureReason  String? // причина отбраковки — показывается автору
  // Потолок длительности, действовавший при загрузке. Хранится в записи, а не
  // берётся из тарифа при обработке: иначе смена уровня задним числом делала бы
  // уже принятый ролик «слишком длинным».
  maxSeconds     Int             @default(90)
  processedAt    DateTime? @db.Timestamptz(3)
  processedBytes Int? // суммарный вес вариантов: видно, во что обходится хранение

  profile PhotographerProfile @relation(fields: [profileId], references: [id])

  @@index([profileId, status])
  @@index([processing, createdAt]) // очередь воркера
}

// Серия (история) — репортаж с одного события
model Story {
  id           String           @id @default(cuid())
  profileId    String
  categoryId   String
  title        String
  description  String?
  coverPhotoId String?
  status       ModerationStatus @default(PENDING)
  rejectReason String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  publishedAt  DateTime? @db.Timestamptz(3)

  profile  PhotographerProfile @relation(fields: [profileId], references: [id])
  category Category            @relation(fields: [categoryId], references: [id])
  photos   Photo[]
  likes    Like[]
  comments Comment[]

  @@index([profileId, status])
  // freshStories (главная) фильтрует по глобальному status + сортирует publishedAt — аудит перф 2026-07-30.
  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
}

// ─── Событийная модель активности (фундамент рейтингов v2, рек-ленты, виджетов)

enum ActivityType {
  PHOTO_LIKE
  PHOTO_UNLIKE
  PHOTO_VIEW
  STORY_LIKE
  STORY_UNLIKE
  STORY_VIEW
  PROFILE_VIEW
  FOLLOW
  UNFOLLOW
  PHOTO_PUBLISH
  STORY_PUBLISH
  COMMENT_CREATE
  PHONE_REVEAL
  COMMENT_DELETE
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

enum TargetType {
  PHOTO
  STORY
  PROFILE
}

// Append-only журнал. Никогда не обновляется и не удаляется —
// рейтинги, лента и виджеты считаются поверх него.
// Журнал событий. ВАЖНО: рейтинг считается НЕ по нему, а по материализованным
// Like (волна №6) — журнал остался источником аналитики просмотров и раскрытий
// телефона в дашборде подписчика. Ретенция 400 дней (jobs/maintenance).
model ActivityEvent {
  id          BigInt       @id @default(autoincrement())
  actorUserId String?
  type        ActivityType
  targetType  TargetType
  targetId    String
  // Вес события на момент записи ×1000 (взвешенные лайки: вес = f(рейтинг актора))
  weightMilli Int          @default(1000)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  actor User? @relation("actor", fields: [actorUserId], references: [id])
  // Индекс [type, createdAt] снят (аудит 2026-08-01, P2): ни один запрос не
  // начинается с type без targetId — все читают журнал по объекту
  // (src/lib/analytics.ts). Лишний индекс дорожал на самой частой записи
  // платформы (beacon просмотра пишет строку на каждый уникальный просмотр).

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
}

// Материализованные лайки (текущее состояние; история — в ActivityEvent)
// Прежние адреса профилей (аудит 2026-08-01, P2). Смена username меняла URL
// профиля молча: все существующие ссылки — из мессенджеров, соцсетей, визиток,
// поисковой выдачи — начинали вести в 404. Для платформы, где профиль и есть
// продукт автора, это потеря аудитории на ровном месте. Старый адрес живёт
// здесь и отдаёт постоянный редирект на актуальный.
//
// Если освободившееся имя займёт ДРУГОЙ автор, запись удаляется: редирект,
// уводящий на чужой профиль, хуже честного 404.
model UsernameHistory {
  id        String   @id @default(cuid())
  username  String   @unique
  profileId String
  changedAt DateTime @default(now()) @db.Timestamptz(3)

  profile PhotographerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Like {
  id          String   @id @default(cuid())
  userId      String
  photoId     String?
  storyId     String?
  weightMilli Int      @default(1000) // вес зафиксирован при лайке; анлайк списывает ЕГО (не текущий)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id])
  photo Photo? @relation(fields: [photoId], references: [id])
  story Story? @relation(fields: [storyId], references: [id])

  @@unique([userId, photoId])
  @@unique([userId, storyId])
  // Ленты «лучшее недели/года» группируют по окну времени (аудит P1): индекс
  // [photoId, createdAt] для такого запроса бесполезен — нужен ведущий createdAt
  @@index([createdAt(sort: Desc)])
  // Горячий путь: ленты (bestOfWindow), рекомендации, пересчёт рейтинга агрегируют
  // Like по photoId + окну createdAt. Like растёт быстрее всех — аудит перф 2026-07-30.
  @@index([photoId, createdAt])
  @@index([userId])
}

// Подтверждённая съёмка: заказчик отметил, что съёмка с автором состоялась.
// Честный якорь доверия (доброжелательная система 2026-07-25): даёт факты
// «снимали вместе N раз» и «клиенты возвращаются», и делает отзыв verified по
// РЕАЛЬНОЙ съёмке, а не по любому сообщению (фикс red-team).
// Подтверждённая съёмка — честный якорь доверия платформы (design-record
// «доброжелательный рейтинг»). Из неё растут публичные факты «снимали вместе
// N раз» / «заказчиков вернулись» и признак verified у отзыва.
//
// Двустороннее подтверждение (S4 trust-хардеринг, 2026-08-02): отметку ставит
// заказчик, но публичной она становится ТОЛЬКО после подтверждения фотографом.
// Односторонняя отметка была self-attested: при открытой регистрации автор
// завёл бы фейковых «заказчиков» и накрутил себе verified-отзывы и факты
// совместных съёмок — то есть подорвал бы ровно то, на чём держится доверие к
// платформе. Сейчас это сдерживает только инвайт-гейт, который на публичном
// запуске снимается.
//
// Трение здесь работает в правильную сторону: подтверждать съёмку выгодно
// самому фотографу — это его репутация.
model ShootConfirmation {
  id           String            @id @default(cuid())
  clientUserId String // заказчик, отметивший съёмку
  profileId    String // фотограф (профиль)
  eventDate    DateTime? @db.Timestamptz(3) // когда была съёмка (опционально)
  state        ShootConfirmState @default(PENDING)
  // Момент реакции фотографа: подтвердил или оспорил
  respondedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  client  User                @relation(fields: [clientUserId], references: [id])
  profile PhotographerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Повторные съёмки с тем же заказчиком — законны («клиенты возвращаются»),
  // но только с РАЗНЫМИ датами: без этого один клиент накручивал «возвращаются»
  // повторными отметками об одной и той же съёмке.
  @@unique([clientUserId, profileId, eventDate])
  @@index([profileId, state, createdAt])
  @@index([clientUserId, profileId])
}

enum ShootConfirmState {
  PENDING // заказчик отметил, фотограф ещё не ответил — публично не считается
  CONFIRMED // подтверждена обеими сторонами
  DISPUTED // фотограф говорит, что съёмки не было
}

model Review {
  id           String        @id @default(cuid())
  authorUserId String // клиент, оставивший отзыв
  profileId    String // фотограф
  rating       Int // 1..5
  body         String
  status       CommentStatus @default(VISIBLE) // VISIBLE по умолчанию; админ может HIDDEN
  verified     Boolean       @default(false) // было реальное взаимодействие (сообщение)
  reply        String? // ответ фотографа
  repliedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  author  User                @relation(fields: [authorUserId], references: [id])
  profile PhotographerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([authorUserId, profileId]) // один отзыв на пару клиент↔фотограф
  @@index([profileId, status, createdAt])
  // «Заказчики рекомендуют» (valuedPhotographers) агрегирует отзывы rating≥4+verified
  // по всей платформе — аудит перф 2026-07-30.
  @@index([status, rating, verified])
  @@index([authorUserId])
}

model Comment {
  id           String        @id @default(cuid())
  authorUserId String
  photoId      String?
  storyId      String?
  body         String
  status       CommentStatus @default(VISIBLE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  author User   @relation(fields: [authorUserId], references: [id])
  photo  Photo? @relation(fields: [photoId], references: [id], onDelete: Cascade)
  story  Story? @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([photoId, status, createdAt])
  @@index([storyId, status, createdAt])
  @@index([authorUserId, createdAt])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  follower User @relation("follower", fields: [followerId], references: [id])
  followee User @relation("followee", fields: [followeeId], references: [id])

  @@id([followerId, followeeId])
  // Обратный индекс (аудит 2026-07-31, P1): count по followeeId выполняется на
  // КАЖДОМ открытии профиля + follow-списки сортируют по createdAt. Составной PK
  // начинается с followerId и для этих запросов бесполезен.
  @@index([followeeId, createdAt(sort: Desc)])
  @@index([followeeId])
}

// Избранные фотографы заказчика (кабинет B2B: сохранить, чтобы вернуться)
model FavoritePhotographer {
  userId    String
  profileId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User                @relation(fields: [userId], references: [id])
  profile PhotographerProfile @relation(fields: [profileId], references: [id])

  @@id([userId, profileId])
  @@index([userId])
  // Счётчик «сохранений» в каталоге и дашборде ищет по profileId (аудит P1)
  @@index([profileId, createdAt(sort: Desc)])
  @@index([profileId])
}

// ─── Заявки заказчиков ──────────────────────────────────────────────────────

enum InquiryStatus {
  OPEN
  CLOSED
}

// Персональная отметка фотографа по заявке (аудит 2026-08-01, P2).
// Заявка веерная: её видят ВСЕ одобренные фотографы города, поэтому общий
// Inquiry.status тут не годится — один закрыл бы лид всем остальным. Отметка
// личная: «беру в работу» / «не берусь». Без неё повторный вход в кабинет не
// показывал, что уже отработано, и лиды терялись — при том что доведение
// заявки до сделки и есть метрика №1 продукта.
model InquiryHandling {
  id        String        @id @default(cuid())
  inquiryId String
  profileId String
  state     HandlingState
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  inquiry Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  profile PhotographerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, profileId])
  @@index([profileId, state])
}

enum HandlingState {
  IN_PROGRESS
  DECLINED
}

model Inquiry {
  id                String        @id @default(cuid())
  clientUserId      String? // может быть гость — тогда контакты ниже
  contactName       String
  contactPhone      String? // E.164
  contactEmail      String?
  cityId            String
  categoryId        String?
  eventDate         DateTime? @db.Timestamptz(3) // дата события (UTC, date-часть)
  budgetMinor       Int?
  currency          String        @default("RUB")
  description       String
  status            InquiryStatus @default(OPEN)
  // Доказательство согласия на обработку ПДн (аудит 2026-07-31, P0): форма
  // заявки собирает имя/телефон/почту гостя, т.е. ПДн — без зафиксированного
  // согласия обработка неправомерна (ст. 9 152-ФЗ). Храним момент и версию
  // редакции политики, как и у аккаунтов (User.pdnConsentAt/Version).
  pdnConsentAt      DateTime? @db.Timestamptz(3)
  pdnConsentVersion String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  handlings InquiryHandling[] // персональные отметки фотографов
  client    User?             @relation(fields: [clientUserId], references: [id])
  city      City              @relation(fields: [cityId], references: [id])
  category  Category?         @relation(fields: [categoryId], references: [id])

  @@index([cityId, status, createdAt(sort: Desc)])
  @@index([clientUserId])
  @@index([categoryId])
}

// ─── Жалобы и блокировки (модерация людей) ──────────────────────────────────
// Аудит 2026-07-31 (P0): у платформы не было НИ ОДНОГО инструмента реакции на
// человека — ни жалобы, ни блокировки собеседника. Для беты с живыми людьми
// (и для позиции информационного посредника) это обязательный минимум.

enum ReportTargetType {
  USER
  PHOTO
  STORY
  REVIEW
  COMMENT
  MESSAGE
}

enum ReportReason {
  SPAM // реклама, навязчивые рассылки
  ABUSE // оскорбления, угрозы, травля
  ADULT // непристойный контент
  COPYRIGHT // чужая работа выдаётся за свою / претензия правообладателя
  PERSONAL_DATA // раскрытие чужих персональных данных, съёмка без согласия
  FRAUD // обман, попытка увести оплату мимо платформы
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED // приняли меры
  DISMISSED // жалоба не подтвердилась
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String? // null — жалоба от гостя (форма правообладателя)
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  comment      String? // пояснение заявителя
  contactEmail String? // для гостевых жалоб (обратная связь правообладателю)
  status       ReportStatus     @default(OPEN)
  resolution   String? // что сделал админ
  resolvedById String?
  resolvedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  reporter   User? @relation("reporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("reportResolver", fields: [resolvedById], references: [id])

  // Антиспам жалобами: один заявитель — одна жалоба на объект
  @@unique([reporterId, targetType, targetId])
  // Очередь админа: свежие открытые сверху
  @@index([status, createdAt(sort: Desc)])
  // Сколько раз жаловались на объект (сигнал для модерации)
  @@index([targetType, targetId])
}

// Блокировка собеседника: заблокированный не может писать в личку.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("blocker", fields: [blockerId], references: [id])
  blocked User @relation("blocked", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ─── Личка и уведомления ────────────────────────────────────────────────────

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  sender    User @relation("sender", fields: [senderId], references: [id])
  recipient User @relation("recipient", fields: [recipientId], references: [id])

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
}

// Мультиканальные уведомления (ADR mobile-strategy): канал — свойство доставки,
// не тип уведомления. EMAIL сейчас, TELEGRAM в S2, WEBSOCKET в S2.
enum NotificationChannel {
  EMAIL
  TELEGRAM
  WEBSOCKET
  IN_APP
}

enum NotificationState {
  QUEUED
  SENT
  FAILED
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  type      String // i18n-ключ шаблона: notification.inquiry.new
  payload   Json
  state     NotificationState   @default(QUEUED)
  error     String?
  readAt    DateTime? @db.Timestamptz(3) // in-app: прочитано (для канала IN_APP)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([state, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── S5 монетизация: PRO-подписка + платежи (Т-Касса) ──────────────────────

enum SubscriptionTier {
  FREE
  PRIME
  ELITE
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  tier             SubscriptionTier @default(FREE)
  currentPeriodEnd DateTime? @db.Timestamptz(3) // до какой даты активен PRO
  grandfathered    Boolean          @default(false) // бесплатный PRO бете (founding)
  // S5-монетизация (deep-think 2026-07-16): цена по городам + триал + бета-грейс.
  cityTier         String? // A|B|C на момент оформления (цена зафиксирована по городу)
  priceMinorLocked Int? // зафиксированная цена (founding-lock) в копейках/мес
  currency         String           @default("RUB") // ISO 4217 — к priceMinorLocked
  trialEndsAt      DateTime? @db.Timestamptz(3) // конец пробного периода (PRO по клику без карты)
  graceEndsAt      DateTime? @db.Timestamptz(3) // конец бесплатного бета-PRO → далее переход на оплату
  proRequestedAt   DateTime? @db.Timestamptz(3) // фотограф запросил подключение PRO (бета: ручная активация оператором)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  user             User             @relation(fields: [userId], references: [id])
}

enum PaymentStatus {
  NEW
  CONFIRMED
  REJECTED
  REFUNDED
}

model Payment {
  id               String           @id @default(cuid())
  // nullable: при удалении аккаунта запись ОБЕЗЛИЧИВАЕТСЯ, а не удаляется —
  // первичные документы по платежам хранятся по закону (НК РФ, 54-ФЗ), но без
  // связи с субъектом ПДн (аудит 2026-07-31, P0 deleteAccount).
  userId           String?
  orderId          String           @unique // наш OrderId — идемпотентность вебхука
  amountMinor      Int // копейки (инвариант: minor units)
  // Код валюты обязателен по денежному инварианту проекта (аудит 2026-07-31, P1):
  // сумма без валюты — единственное место, где инвариант нарушался. Пока RUB,
  // но задел на мир заявлен с первого дня, а миграция денег задним числом дорога.
  currency         String           @default("RUB") // ISO 4217
  tier             SubscriptionTier // какой уровень оплачивается (зачисляется на CONFIRMED)
  status           PaymentStatus    @default(NEW)
  // Уникален: Т-Касса при ретраях присылает тот же PaymentId, и без этого
  // ограничения повторная доставка вебхука под другим OrderId могла бы
  // зачислиться дважды (S5-блокер, аудит 2026-07-26).
  tinkoffPaymentId String?          @unique // PaymentId от Т-Кассы
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  user             User?            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

// ─── Аудит действий администратора (spec/02-admin §8.4) ─────────────────────
// Отдельно от append-only ActivityEvent: та про продуктовую активность,
// эта — про действия оператора над чужими данными/статусами (P0, реверсивность).
model AdminAudit {
  id          BigInt   @id @default(autoincrement())
  // nullable: аудит-след административных действий не удаляется (доказательность),
  // но теряет связь с удалённым аккаунтом (аудит 2026-07-31, P0 deleteAccount).
  actorUserId String?
  action      String // 'profile.approve', 'profile.reject', 'user.ban'…
  targetType  String
  targetId    String
  meta        Json? // причина, diff полей, снимок затронутых id
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

// Сброс пароля по email-ссылке (нужно при открытой регистрации). Токен хранится
// как sha256-хеш; сырой — только в письме. TTL + одноразовость.
// Подтверждение email (аудит 2026-07-31, P0): адрес не проверялся никогда —
// опечатка при регистрации навсегда убивала аккаунт (восстановление пароля
// уходило в никуда), а чужой адрес можно было занять сквоттингом. Тот же
// паттерн, что у сброса пароля: в БД только sha256-хеш, сырой — в письме.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  email     String // адрес на момент выдачи (защита от подмены после выдачи)
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Резервные коды 2FA (одноразовые). Хранятся как sha256-хеш; сырые показываются
// пользователю один раз при включении. Восстановление при утере аутентификатора.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Прогон фоновой задачи — heartbeat для админки.
///
/// Все периодические задачи (обслуживание, транскод, бэкап) до сих пор были
/// «чёрными ящиками»: узнать, что задача не отработала, можно было только по
/// последствиям. Порог тревоги задаётся под РЕАЛЬНУЮ частоту задачи, иначе
/// либо ложные тревоги сразу после деплоя, либо тишина месяцами.
model JobRun {
  id         String    @id @default(cuid())
  name       String // maintenance | video | backup | uptime
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  ok         Boolean?
  note       String? // что сделано или чем упало — коротко, без ПДн
  tookMs     Int?

  @@index([name, startedAt(sort: Desc)])
}

/// След решения по cookie на СТОРОНЕ ОПЕРАТОРА.
///
/// До 2026-08-03 решение жило только в браузере пользователя, а в коде стоял
/// комментарий «это доказуемый след». Это было не так: cookie у субъекта не
/// доказательство для оператора — она стирается очисткой браузера, и предъявить
/// ни момент, ни содержание согласия было нечем.
///
/// Пишем минимум, достаточный для доказательства и не создающий новых рисков:
/// решение, редакцию политики, время и ХЕШ адреса (сам IP не храним — он тоже
/// персональные данные, а для сверки достаточно совпадения хеша).
model CookieConsent {
  id            String   @id @default(cuid())
  decision      String // all | necessary
  policyVersion String
  ipHash        String? // sha256(ip + соль); сырой адрес не сохраняем
  userId        String? // если решение принял вошедший пользователь
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([userId])
}
