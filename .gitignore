# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — секреты НИКОГДА в git; пример-шаблон коммитим
.env*
!.env.example

# internal docs / secrets (живут в docs-vault вне репо)
docs-vault/
credentials*

# dev-мусор
*.log
*.tmp
scratch/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# локальное хранилище загрузок (dev)
.uploads/
.design-preview/
.agents/
.claude/skills/
skills-lock.json
