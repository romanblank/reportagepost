# Шаблон окружения. Реальные значения — в .env (вне git) и в vault/credentials.md.
DATABASE_URL=postgresql://user:password@localhost:5432/reportagepost
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMS_PROVIDER_API_KEY=
SMTP_URL=
AUTH_SECRET= # >=32 символов, openssl rand -base64 48
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER= # имя отправителя после модерации SMSC

# AI-подбор (опционально, НЕ Яндекс): LLM-фолбэк для необычных брифов, когда
# эвристика не нашла город/жанр. OpenAI-совместимый эндпоинт. Без этих переменных
# подбор работает на чистой эвристике.
#   Mistral (выбран, ключ на console.mistral.ai):
LLM_API_URL=https://api.mistral.ai/v1/chat/completions
LLM_MODEL=mistral-small-latest
# LLM_API_KEY=  # ← вставить ключ Mistral (secret, вне git)
#   Другие OpenAI-совместимые (на будущее):
#     DeepSeek:      LLM_API_URL=https://api.deepseek.com/chat/completions  LLM_MODEL=deepseek-chat
#     Self-hosted:   LLM_API_URL=http://localhost:11434/v1/chat/completions  LLM_MODEL=mistral
